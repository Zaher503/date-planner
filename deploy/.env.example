# Copy to deploy/.env on the Zephyrus (mode 600). Never commit the real file.

# Postgres
PG_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dates:change-me@db:5432/dates

# Key for POST /api/add (iPhone Shortcut, add-date.ps1)
DATES_KEY=change-me

# Only requests from this address may carry Authentik identity headers
TRUSTED_PROXY=192.168.0.70

# The shared AI hub gateway (see docs/OPERATIONS.md) - this is the only value that works now;
# "http://ollama:11434" was the pre-ai-hub Recipe Box name and is stale, left over from before
# the 2026-10-12 migration (docs/TODO-ZAHER.md)
OLLAMA_URL=http://ai-hub:11434
LLM_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text

# Key for the keyed import-tester service (POST with header X-Tester-Key). Separate from
# DATES_KEY on purpose: this one is reachable from outside the LAN behind its own Caddy route,
# so a leak of it can only run test imports, never touch real data or any other key/secret
TESTER_KEY=change-me

# Home Assistant (zone.home for the map center, notify for pushes)
HA_URL=http://192.168.0.108:8123
HA_TOKEN=
NOTIFY_TARGETS=mobile_app_zahers_17pm,mobile_app_katherines_phone

# Internal services
SEARXNG_SECRET=change-me
PHOTON_URL=http://photon:2322
OSRM_CAR_URL=http://osrm-car:5000
OSRM_FOOT_URL=http://osrm-foot:5000
SEARXNG_URL=http://searxng:8080

# Free event source keys (optional, adapters skip themselves when empty)
TICKETMASTER_KEY=

# Data dir inside the containers (host: /srv/dateplanner)
DATA_DIR=/data
